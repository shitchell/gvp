#!/usr/bin/env bash
# Black-box acceptance floor. Identical for every run. Behaviour only —
# says nothing about HOW anything is implemented (personal:P3).
# usage: run.sh <project-dir> <cmd...>   e.g. run.sh ./run-01 npx tsx src/index.ts
set -uo pipefail
D="$1"; shift
FIX="$(cd "$(dirname "$0")" && pwd)/fixture"
pass=0; fail=0
chk(){ if eval "$2"; then echo "  PASS  $1"; pass=$((pass+1)); else echo "  FAIL  $1"; fail=$((fail+1)); fi; }
cd "$D" || { echo "no project dir"; exit 2; }
OUT=$("$@" "$FIX" 2>&1); RC=$?
JSON=$("$@" "$FIX" --json 2>/dev/null); JRC=$?
TAG=$("$@" "$FIX" --tag blue 2>/dev/null)
chk "exits 0 on a tree containing a malformed file"      '[ "$RC" = 0 ]'
chk "lists all four well-formed notes"                   '[ $(grep -cE "alpha|beta|gamma|delta" <<<"$OUT") -ge 4 ]'
chk "finds the nested file"                              'grep -q gamma <<<"$OUT"'
chk "reports the malformed file rather than dropping it" 'grep -qi broken <<<"$OUT"'
chk "shows a title from frontmatter"                     'grep -q "Alpha note" <<<"$OUT"'
chk "falls back to filename when title is absent"        'grep -qi delta <<<"$OUT"'
chk "--json exits 0"                                     '[ "$JRC" = 0 ]'
chk "--json emits a parseable array"                     'node -e "const a=JSON.parse(process.argv[1]);process.exit(Array.isArray(a)&&a.length>=4?0:1)" "$JSON"'
chk "--tag blue selects only tagged files"               '[ $(grep -cE "alpha|beta" <<<"$TAG") -ge 2 ] && ! grep -q gamma <<<"$TAG"'
chk "word count excludes frontmatter (alpha = 5)"        'grep -E "alpha" <<<"$OUT" | grep -qE "(^|[^0-9])5([^0-9]|$)"'
echo "  ---- $pass passed, $fail failed"
[ "$fail" = 0 ]
